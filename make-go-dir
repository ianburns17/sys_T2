
#!/bin/bash

# Check if exactly two arguments were provided
if [ "$#" -ne 2 ]; then
    echo "You need to provide two arguments for this script to work."
    echo "Usage: make-go-dir <root directory name> <identifier name>"
    exit 1
fi

# Assign arguments to variables
ROOT_DIR=$1
IDENTIFIER=$2

# Ask the user for confirmation
echo "I am about to create a directory structure named '$ROOT_DIR'."
read -p "Do you want me to continue? [Yes/no] " RESPONSE

# Check user's response
if [[ "$RESPONSE" == "Yes" || "$RESPONSE" == "yes" ]]; then

    echo "Create directory structure..."

    # Create the directory structure
    mkdir -p "$ROOT_DIR"/{bin,cmd/api,internals,migrations,remote}

    # Create main.go file
    cat > "$ROOT_DIR/cmd/api/main.go" <<EOF
// File: cmd/api/main.go

package main

import "fmt"

func main() {
    fmt.Println("Hello world!")
}
EOF

    # Create go.mod file
    echo "module $ROOT_DIR.$IDENTIFIER" > "$ROOT_DIR/go.mod"

    # Create make-file
    touch "$ROOT_DIR/make-file"

    # Display completion messages
    echo "I have created a *main.go* file for you to test the directory structure."
    echo "Type *go run ./cmd/api* at the root directory of your project to test your project."
    echo "Thank you."

elif [[ "$RESPONSE" == "no" || "$RESPONSE" == "No" ]]; then

    echo "Abort."

else
    echo "Invalid response. Abort."
fi
